{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fomi-assistant",
  "version": "0.1.0",
  "identifier": "com.makss_mef.fomi-assistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Fomi AI",
        "width": 600,
        "height": 800,
        "maximized": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "devtools": true,
        "shadow": false
      },
      {
        "label": "dashboard",
        "url": "dashboard.html",
        "title": "Fomi Dashboard",
        "transparent": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "width": 900,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/**/*",
      "dlls/**/*"
    ],
    "externalBin": [
      "binaries/whisper-cli",
      "binaries/piper"
    ]
  }
}
