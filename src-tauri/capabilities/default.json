{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "dashboard"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "shell:default",
    "shell:allow-execute",
    "core:event:allow-emit"
  ],
  "commands": {
    "allow": [
      "process_voice_input"
    ]
  }
}
